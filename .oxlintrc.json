{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-extraneous-class": ["warn", { "allowWithDecorator": true }],
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["warn", { "allow": ["**/*.css"] }],
    "eqeqeq": "error",
    "no-console": "error"
  },
  "overrides": [
    {
      // Nest resolves constructor dependencies from emitted decorator metadata, which needs value imports of the injected classes.
      "files": ["apps/api/**"],
      "rules": {
        "typescript/consistent-type-imports": "off"
      }
    },
    {
      "files": ["apps/web/**"],
      "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "react",
        "react-perf",
        "jsx-a11y",
        "nextjs"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off"
      }
    },
    {
      "files": ["apps/api/prisma/seed.ts"],
      "rules": {
        "no-console": "off"
      }
    }
  ],
  "ignorePatterns": ["**/dist/**", "**/.next/**", "**/generated/**", "dataset/**"]
}
