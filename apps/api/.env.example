# Schema owner: used only by the Prisma CLI (migrate, seed). Bypasses RLS, never used by the running app.
OWNER_DATABASE_URL=postgresql://arrowfin_owner:owner_dev_password@localhost:55432/arrowfin
# Runtime role: subject to row-level security.
APP_DATABASE_URL=postgresql://arrowfin_app:app_dev_password@localhost:55432/arrowfin
NODE_ENV=development
PORT=3001
# Origins allowed for CORS and for the WebSocket handshake.
WEB_ORIGINS=http://localhost:3000
# At least 32 random bytes, e.g. `openssl rand -base64 48`.
JWT_SECRET=change-me-change-me-change-me-change-me-change-me
# Dev-only: mounts POST /dev/login and POST /dev/fills. Refused at boot when NODE_ENV=production.
ENABLE_DEV_TOOLS=true
# Replays the dataset cut as "now" (time keeps moving from it). Empty means the system clock.
CLOCK_ANCHOR=2026-08-25T14:30:00Z
