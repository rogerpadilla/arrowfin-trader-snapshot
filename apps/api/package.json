    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "contracts": "*",
    "cookie": "^2.0.2",
    "decimal.js": "^10.6.0",
    "jose": "^6.2.17",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
